# aibank configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Nothing here has a working default: the service REFUSES
# to boot without AIBANK_ADMIN_KEY and AIBANK_KEY_PEPPER, because the previous
# behaviour -- silently falling back to published constants -- meant a
# deployment that forgot them had a publicly known admin credential and no
# error to warn anyone.

# ---------------------------------------------------------------------------
# Required secrets. Generate each with:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
# ---------------------------------------------------------------------------

# Platform operator credential (X-Admin-Key): pricing, settlement deposits,
# the sweeper, cross-tenant reads.
AIBANK_ADMIN_KEY=

# Added to every API key before hashing. CHANGING THIS INVALIDATES EVERY
# EXISTING AGENT KEY -- it is not rotatable without reissuing them, so set it
# once at install and then leave it alone. Back it up with the ledger: a
# restored database without its pepper has no working agent keys.
AIBANK_KEY_PEPPER=

# ---------------------------------------------------------------------------
# Provider (Flutterwave). Leave blank to run with no real payout path.
# ---------------------------------------------------------------------------
FLW_SECRET_KEY=
# Webhook signing secret. Required to accept callbacks -- an unverified
# webhook endpoint lets anyone mark any payout successful.
FLW_SECRET_HASH=

# ---------------------------------------------------------------------------
# Deployment shape
# ---------------------------------------------------------------------------

# Set to 1 ONLY when the service is unreachable except through a reverse proxy
# that OVERWRITES X-Forwarded-For (deploy/nginx.conf does). It makes aibank key
# its per-address login throttle on that header instead of the socket address.
#
# Wrong in either direction hurts: left at 0 behind a proxy, every user shares
# one throttle bucket and the first sprayer locks out the world; set to 1 while
# the port is directly reachable, a client can forge the header to get
# unlimited fresh buckets and to frame any address in the audit log.
AIBANK_TRUSTED_PROXY=1

# ---------------------------------------------------------------------------
# Optional tuning. Shown with defaults; all safe to omit.
# ---------------------------------------------------------------------------

# Per-account failed sign-ins before lockout, and the window in minutes.
#AIBANK_LOCKOUT_THRESHOLD=8
#AIBANK_LOCKOUT_WINDOW_MIN=15

# Per-source-address failures before that address is throttled. Higher than
# the per-account number on purpose: a NAT'd office or mobile gateway puts
# many legitimate users behind one address.
#AIBANK_IP_LOCKOUT_THRESHOLD=30

# Dashboard session lifetime.
#AIBANK_SESSION_TTL_HOURS=12

# scrypt cost. The default (2^14) is the production value. Lower it ONLY for
# tests on constrained hardware; it is the strength of every stored password.
#AIBANK_SCRYPT_N=16384

# NEVER set this outside local development. It restores the insecure defaults
# for the two secrets above.
#AIBANK_ALLOW_DEV_SECRETS=1
